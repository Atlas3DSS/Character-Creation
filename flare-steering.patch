+    old.as_object_mut().unwrap().remove("steering");
+    config.contract = serde_json::from_value(old).unwrap();
+    assert!(config.contract.steering.is_none());
+    assert!(Inputs::new(&config, &manifest(&config)).is_ok());
+}
